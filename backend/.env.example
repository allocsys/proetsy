# Gemini: comma-separated pool of free-tier API keys (round-robin + 429 retry across them)
GEMINI_API_KEYS=

# Optional Claude fallback — stays disabled unless LLM_PROVIDER=claude and this is set
CLAUDE_API_KEY=

# Which LLM provider is active: gemini (default) | claude
LLM_PROVIDER=gemini

# Which trends provider is active: manual (default, includes CSV import) | etsy_api
TRENDS_PROVIDER=manual

# Only needed if TRENDS_PROVIDER=etsy_api — Etsy's official Open API v3 key
ETSY_API_KEY=

PORT=4000
DB_PATH=./data/proetsy.db
