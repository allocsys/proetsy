# Gemini: comma-separated pool of free-tier API keys (round-robin + 429 retry across them)
GEMINI_API_KEYS=

# Gemini: comma-separated model priority list. On a given key, models are tried in this
# order (Flash first for headroom) before rotating to the next key. See ARCHITECTURE.md ->
# LLM Provider Layer -> "Model cascade within a key".
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-pro

# Gemini: default cooldown (ms) applied to a (key, model) pair after a 429 when Gemini's
# response doesn't include its own retry-delay signal (Retry-After header / retryInfo.
# retryDelay). See ARCHITECTURE.md -> LLM Provider Layer -> "Rate-limit cooldown tracking".
LLM_RATE_LIMIT_DEFAULT_COOLDOWN_MS=60000

# Gemini: ceiling (ms) on a (key, model) pair's cooldown as it escalates (doubles) across
# consecutive 429s that land before the previous cooldown has elapsed. Resets to the base
# duration once a call to that pair succeeds. See ARCHITECTURE.md -> LLM Provider Layer ->
# "Cooldown escalation instead".
LLM_RATE_LIMIT_MAX_COOLDOWN_MS=1800000

# Gemini: minimum spacing (ms) between consecutive requests on the same key — a floor, not
# an average. See ARCHITECTURE.md -> LLM Provider Layer -> "Request spacing, concurrency
# limits & jitter".
LLM_MIN_REQUEST_INTERVAL_MS=1000

# Gemini: randomized jitter (ms), added on top of LLM_MIN_REQUEST_INTERVAL_MS, so requests
# land at slightly irregular intervals rather than a fixed-timer drumbeat.
LLM_REQUEST_JITTER_MS=400

# Gemini: global concurrency cap across the whole key pool (independent of key count) —
# bulk mode won't fire more than this many requests at once even with several keys
# available.
LLM_MAX_CONCURRENT_REQUESTS=2

# Optional Claude fallback — stays disabled unless LLM_PROVIDER=claude and this is set
CLAUDE_API_KEY=

# Which LLM provider is active: gemini (default) | claude
LLM_PROVIDER=gemini

# Which trends provider is active: manual (default, includes CSV import) | etsy_api
TRENDS_PROVIDER=manual

# Only needed if TRENDS_PROVIDER=etsy_api — Etsy's official Open API v3 key
ETSY_API_KEY=

PORT=4000
DB_PATH=./data/proetsy.db

# Module 3 (Mockup Composer): how large an artwork/template aspect-ratio mismatch has to
# be (as a fraction, e.g. 0.35 = 35%) before a mockup gets a warning flagged on it. Below
# this, a smart crop is used silently; at/above it, a warning notes that AI outpainting
# would preserve more content but isn't implemented yet — the mockup is still produced,
# not blocked. See ARCHITECTURE.md -> Module 3 -> "Aspect-ratio mismatch handling".
MOCKUP_LARGE_MISMATCH_RATIO=0.35

# Module 3: optional overrides for where mockup templates are read from and generated
# mockups are written to. Both default to paths relative to the backend package root
# (backend/templates/... via product-sizes.json's mockup_template values, and
# backend/data/mockups/ respectively) if unset.
MOCKUP_TEMPLATES_DIR=
MOCKUP_OUTPUT_DIR=
