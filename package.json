{
  "name": "proetsy",
  "version": "0.1.0",
  "author": "allocsys",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "electron:dev": "concurrently -n frontend,electron -c green,magenta \"npm run dev -w frontend\" \"electron electron/main.js\"",
    "electron:rebuild": "electron-builder install-app-deps",
    "electron:build": "npm run build -w frontend && electron-builder --win",
    "lint": "eslint backend frontend/src",
    "test": "npm run test -w backend && npm run test:electron && npm run test -w frontend",
    "test:electron": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.allocsys.proetsy",
    "productName": "ProEtsy",
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "!backend/data/**",
      "!backend/**/*.test.js",
      "!backend/lib/__fixtures__/**",
      "!backend/.env",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
